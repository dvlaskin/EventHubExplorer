@using Domain.Configs
@using Domain.Enums
@rendermode InteractiveServer

<header class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <NavLink class="navbar-brand" href="" Match="NavLinkMatch.All">EventHub Explorer</NavLink>
    </div>
</header>

<input type="checkbox"
       class="navbar-toggler"
       title="Navigation menu"
       aria-label="Toggle navigation menu"
       aria-controls="primary-navigation" />

<div class="nav-scrollable">
    <nav id="primary-navigation" class="nav flex-column" aria-label="Primary">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3 mt-3">
            <button type="button"
                    class="nav-link nav-section-toggle @(IsEventHubRouteActive ? "nav-section-toggle--active" : string.Empty)"
                    @onclick="ToggleEventHubs"
                    aria-expanded="@isEventHubsExpanded"
                    aria-controls="eventhubs-nav-group">
                <span class="nav-section-header">EventHubs</span>
                <i class="bi @(isEventHubsExpanded ? "bi-chevron-up" : "bi-chevron-down") nav-section-chevron" aria-hidden="true"></i>
            </button>
        </div>

        <div id="eventhubs-nav-group" hidden="@(!isEventHubsExpanded)">
            @foreach (var eventHub in EventHubsConfigs ?? Enumerable.Empty<EventHubConfig>())
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-link--compact" href="@($"eventhub/{eventHub.Id}")">
                        <span class="icon">
                            <i class="bi bi-event-hubs-nav-menu" aria-hidden="true"></i>
                        </span>
                        <span class="text">
                            @eventHub.Title
                        </span>
                    </NavLink>
                </div>
            }
        </div>

        <div class="nav-item px-3 mt-3">
            <button type="button"
                    class="nav-link nav-section-toggle @(IsStorageQueueRouteActive ? "nav-section-toggle--active" : string.Empty)"
                    @onclick="ToggleStorageQueues"
                    aria-expanded="@isStorageQueuesExpanded"
                    aria-controls="storagequeue-nav-group">
                <span class="nav-section-header">StorageQueues</span>
                <i class="bi @(isStorageQueuesExpanded ? "bi-chevron-up" : "bi-chevron-down") nav-section-chevron" aria-hidden="true"></i>
            </button>
        </div>

        <div id="storagequeue-nav-group" hidden="@(!isStorageQueuesExpanded)">
            @foreach (var queueConfig in StorageQueuesConfigs ?? Enumerable.Empty<StorageQueueConfig>())
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-link--compact" href="@($"storagequeue/{queueConfig.Id}")">
                        <span class="icon">
                            <i class="bi bi-inbox-fill" aria-hidden="true"></i>
                        </span>
                        <span class="text">
                            @queueConfig.Title
                        </span>
                    </NavLink>
                </div>
            }
        </div>

        <div class="nav-item px-3 mt-3">
            <button type="button"
                    class="nav-link nav-section-toggle @(IsServiceBusRouteActive ? "nav-section-toggle--active" : string.Empty)"
                    @onclick="ToggleServiceBus"
                    aria-expanded="@isServiceBusExpanded"
                    aria-controls="servicebus-nav-group">
                <span class="nav-section-header">ServiceBus</span>
                <i class="bi @(isServiceBusExpanded ? "bi-chevron-up" : "bi-chevron-down") nav-section-chevron" aria-hidden="true"></i>
            </button>
        </div>

        <div id="servicebus-nav-group" hidden="@(!isServiceBusExpanded)">
            @foreach (var sbConfig in ServiceBusConfigs ?? Enumerable.Empty<ServiceBusConfig>())
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-link--compact" href="@($"servicebus/{sbConfig.Id}")">
                        <span class="icon">
                            <i class="bi bi-send-fill" aria-hidden="true"></i>
                        </span>
                        <span class="text" title="@(sbConfig.EntityType == ServiceBusEntityType.Topic ? $"{sbConfig.EntityName} ({sbConfig.SubscriptionName})" : sbConfig.EntityName)">
                            @sbConfig.Title
                        </span>
                    </NavLink>
                </div>
            }
        </div>
        
        <div class="nav-item px-3 mt-3">
            <NavLink class="nav-link" href="configuration">
                <span class="bi bi-config-nav-menu" aria-hidden="true"></span> Configuration
            </NavLink>
        </div>
        
    </nav>
</div>
