<div class="message-receive-panel d-flex flex-column h-100">
    <div class="mb-3 flex-grow-1 d-flex flex-column min-height-0">
        <label class="form-label label-section">@ReceiveLabel</label>
        @if (!HasMessages || MessageList is null)
        {
            <div class="receive-empty-state" role="status" aria-live="polite">
                No messages received yet.
            </div>
        }
        else
        {
            @MessageList
        }
    </div>

    <div class="mt-auto">
        <p class="receive-status" role="status" aria-live="polite">
            @(IsProcessing ? "Receiving messages..." : HasMessages ? "Messages loaded." : "Receiver is idle.")
        </p>

        @if (IsProcessing)
        {
            <button class="btn btn-primary w-100" type="button" @onclick="OnStopReceive">Stop Receive</button>
        }
        else
        {
            <div class="d-flex gap-2">
                <button class="btn btn-primary flex-grow-1" type="button" @onclick="OnStartReceive">Start Receive</button>
                @if (HasMessages)
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="OnClearMessages">Clear</button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsProcessing { get; set; }
    [Parameter] public bool HasMessages { get; set; }
    [Parameter] public string ReceiveLabel { get; set; } = "Received Messages";
    [Parameter] public RenderFragment? MessageList { get; set; }

    [Parameter] public EventCallback OnStartReceive { get; set; }
    [Parameter] public EventCallback OnStopReceive { get; set; }
    [Parameter] public EventCallback OnClearMessages { get; set; }
}
