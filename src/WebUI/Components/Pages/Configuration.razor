@page "/Configuration"
@using Domain.Configs
@using Domain.Enums
@using Domain.Interfaces.Providers
@using Domain.Interfaces.Services

@inject IFileStorageProvider<AppConfiguration> ConfigurationProvider
@inject IMessageHistoryService MessagesHistoryService

@rendermode InteractiveServer

<PageTitle>Configuration</PageTitle>

<!-- Page Header (mini-hero) -->
<div class="config-header">
    <i class="bi bi-gear-wide-connected config-header-icon"></i>
    <h1 class="config-header-title">Configuration</h1>
    <p class="config-header-subtitle">Manage your Azure messaging service connections</p>
</div>

<!-- Sticky Actions Bar -->
<div class="sticky-actions">
    <div class="d-flex gap-2 flex-wrap align-items-center">
        @if (activeTab == "eventhubs")
        {
            <button class="btn btn-primary" @onclick="AddNewEventHubConfig">
                <i class="bi bi-plus-lg me-1"></i>Add EventHub
            </button>
        }
        else if (activeTab == "storagequeues")
        {
            <button class="btn btn-primary" @onclick="AddNewStorageQueueConfig">
                <i class="bi bi-plus-lg me-1"></i>Add StorageQueue
            </button>
        }
        else if (activeTab == "servicebus")
        {
            <button class="btn btn-primary" @onclick="AddNewServiceBusConfig">
                <i class="bi bi-plus-lg me-1"></i>Add ServiceBus
            </button>
        }
        else if (activeTab == "rabbitmq")
        {
            <button class="btn btn-primary" @onclick="AddNewRabbitMqConfig">
                <i class="bi bi-plus-lg me-1"></i>Add RabbitMQ
            </button>
        }
        <button class="btn btn-success" @onclick="SaveConfiguration">
            <i class="bi bi-floppy me-1"></i>Save Configuration
        </button>
    </div>
</div>

<!-- Custom Tab Navigation -->
<div class="config-tabs">
    <button class="config-tab @(activeTab == "eventhubs" ? "config-tab--active" : "")"
            @onclick='() => SetActiveTab("eventhubs")'>
        <i class="bi bi-broadcast"></i>
        EventHubs
        <span class="config-tab-badge">@(appConfiguration?.EventHubsConfigs.Count ?? 0)</span>
    </button>
    <button class="config-tab @(activeTab == "storagequeues" ? "config-tab--active" : "")"
            @onclick='() => SetActiveTab("storagequeues")'>
        <i class="bi bi-inbox-fill"></i>
        StorageQueues
        <span class="config-tab-badge">@(appConfiguration?.StorageQueuesConfigs.Count ?? 0)</span>
    </button>
    <button class="config-tab @(activeTab == "servicebus" ? "config-tab--active" : "")"
            @onclick='() => SetActiveTab("servicebus")'>
        <i class="bi bi-send-fill"></i>
        ServiceBus
        <span class="config-tab-badge">@(appConfiguration?.ServiceBusConfigs.Count ?? 0)</span>
    </button>
    <button class="config-tab @(activeTab == "rabbitmq" ? "config-tab--active" : "")"
            @onclick='() => SetActiveTab("rabbitmq")'>
        <i class="bi bi-hdd-network-fill"></i>
        RabbitMQ
        <span class="config-tab-badge">@(appConfiguration?.RabbitMqConfigs.Count ?? 0)</span>
    </button>
</div>

<!-- Configuration Content -->
<div class="tab-content mt-3">

    @if (activeTab == "eventhubs")
    {
        @if (appConfiguration?.EventHubsConfigs.Count == 0)
        {
            <div class="config-empty-state">
                <i class="bi bi-broadcast config-empty-icon"></i>
                <p class="config-empty-title">No EventHubs configured</p>
                <p class="config-empty-hint">Click "Add EventHub" to create your first connection.</p>
            </div>
        }
        else
        {
            <div class="accordion" id="eventHubAccordion">
                @for (var i = 0; i < appConfiguration?.EventHubsConfigs.Count; i++)
                {
                    var index = i;
                    var eventHub = appConfiguration.EventHubsConfigs[i];
                    var isExpanded = IsEventHubExpanded(eventHub.Id);
                    var collapseId = $"collapse-eh-{eventHub.Id:N}";
                    var headingId = $"heading-eh-{eventHub.Id:N}";
                    var titleInputId = $"eh-title-{i}";
                    var connectionStringInputId = $"eh-connection-string-{i}";
                    var eventHubNameInputId = $"eh-name-{i}";
                    var useGzipInputId = $"eh-use-gzip-{i}";
                    var useBase64InputId = $"eh-use-base64-{i}";
                    var useCheckpointsInputId = $"eh-use-checkpoints-{i}";
                    var layoutPresetInputId = $"eh-layout-preset-{i}";
                    var blobConnectionStringInputId = $"eh-blob-connection-string-{i}";
                    var blobContainerNameInputId = $"eh-blob-container-name-{i}";

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button @(isExpanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId" aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@collapseId"
                                    @onclick="() => ToggleEventHub(eventHub.Id)">
                                @eventHub.Title
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @(isExpanded ? "show" : "")" aria-labelledby="@headingId"
                             data-bs-parent="#eventHubAccordion">
                            <div class="accordion-body">
                                <div class="mb-3">
                                    <label class="form-label" for="@titleInputId">Title</label>
                                    <input id="@titleInputId" class="form-control" @bind="eventHub.Title">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@connectionStringInputId">Connection String</label>
                                    <input id="@connectionStringInputId" class="form-control" @bind="eventHub.ConnectionString">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@eventHubNameInputId">EventHub Name</label>
                                    <input id="@eventHubNameInputId" class="form-control" @bind="eventHub.Name">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@layoutPresetInputId">Blocks layout</label>
                                    <select id="@layoutPresetInputId" class="form-select" @bind="eventHub.MessagePageLayout">
                                        <option value="@MessagePageLayoutPreset.TopSendReceiveBottomPayload">Top: Send + Receive, Bottom: Payload</option>
                                        <option value="@MessagePageLayoutPreset.LeftSendReceiveRightPayload">Left: Send + Receive, Right: Payload</option>
                                        <option value="@MessagePageLayoutPreset.LeftSendRightReceiveBottomPayload">Left: Send, Right: Receive + Payload (50/50)</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <h6 class="config-section-label">Message encoding settings</h6>
                                    <div class="form-check d-inline-block me-3">
                                        <input id="@useGzipInputId" class="form-check-input" type="checkbox" @bind="eventHub.UseGzipCompression"
                                               @bind:after="@(() => OnGzipCompressionChanged(eventHub))">
                                        <label class="form-check-label" for="@useGzipInputId">Use Gzip Compression</label>
                                    </div>
                                    <div class="form-check d-inline-block">
                                        <input id="@useBase64InputId" class="form-check-input" type="checkbox" @bind="eventHub.UseBase64Coding"
                                               disabled="@(!eventHub.UseGzipCompression)">
                                        <label class="form-check-label" for="@useBase64InputId">Use Base64 Coding</label>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <h6 class="config-section-label">Message formatting settings</h6>
                                    @{
                                        var formatterIndex = 0;
                                    }
                                    @foreach (var formatter in eventHub.MessageFormatters)
                                    {
                                        var formatterId = $"eh-formatter-{i}-{formatterIndex++}";
                                        <div class="form-check d-inline-block me-3">
                                            <input id="@formatterId" class="form-check-input" type="checkbox"
                                                   @bind:get="formatter.Value"
                                                   @bind:set="(value) => eventHub.MessageFormatters[formatter.Key] = value">
                                            <label class="form-check-label" for="@formatterId">@formatter.Key</label>
                                        </div>
                                    }
                                </div>
                                <div class="form-check mb-3">
                                    <input id="@useCheckpointsInputId" class="form-check-input" type="checkbox" @bind="eventHub.UseCheckpoints">
                                    <label class="form-check-label" for="@useCheckpointsInputId">Use Checkpoints</label>
                                </div>

                                @if (eventHub.UseCheckpoints)
                                {
                                    eventHub.StorageConfig ??= new BlobConfig { ConnectionString = "", BlobContainerName = "" };

                                    <h5 class="config-section-label">Blob Storage</h5>
                                    <div class="mb-3">
                                        <label class="form-label" for="@blobConnectionStringInputId">Connection String</label>
                                        <input id="@blobConnectionStringInputId" class="form-control" @bind="eventHub.StorageConfig.ConnectionString">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="@blobContainerNameInputId">Container Name</label>
                                        <input id="@blobContainerNameInputId" class="form-control" @bind="eventHub.StorageConfig.BlobContainerName">
                                    </div>
                                }

                                <button class="btn btn-danger" @onclick="() => RemoveEventHubConfig(index)">Remove</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @if (activeTab == "storagequeues")
    {
        @if (appConfiguration?.StorageQueuesConfigs.Count == 0)
        {
            <div class="config-empty-state">
                <i class="bi bi-inbox-fill config-empty-icon"></i>
                <p class="config-empty-title">No StorageQueues configured</p>
                <p class="config-empty-hint">Click "Add StorageQueue" to create your first connection.</p>
            </div>
        }
        else
        {
            <div class="accordion" id="storageQueueAccordion">
                @for (var i = 0; i < appConfiguration?.StorageQueuesConfigs.Count; i++)
                {
                    var index = i;
                    var queueConfig = appConfiguration.StorageQueuesConfigs[i];
                    var isExpanded = IsStorageQueueExpanded(queueConfig.Id);
                    var collapseId = $"collapse-sq-{queueConfig.Id:N}";
                    var headingId = $"heading-sq-{queueConfig.Id:N}";
                    var titleInputId = $"sq-title-{i}";
                    var connectionStringInputId = $"sq-connection-string-{i}";
                    var queueNameInputId = $"sq-name-{i}";
                    var useGzipInputId = $"sq-use-gzip-{i}";
                    var useBase64InputId = $"sq-use-base64-{i}";
                    var layoutPresetInputId = $"sq-layout-preset-{i}";

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button @(isExpanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId" aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@collapseId"
                                    @onclick="() => ToggleStorageQueue(queueConfig.Id)">
                                @queueConfig.Title
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @(isExpanded ? "show" : "")" aria-labelledby="@headingId"
                             data-bs-parent="#storageQueueAccordion">
                            <div class="accordion-body">
                                <div class="mb-3">
                                    <label class="form-label" for="@titleInputId">Title</label>
                                    <input id="@titleInputId" class="form-control" @bind="queueConfig.Title">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@connectionStringInputId">Connection String</label>
                                    <input id="@connectionStringInputId" class="form-control" @bind="queueConfig.ConnectionString">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@queueNameInputId">Queue Name</label>
                                    <input id="@queueNameInputId" class="form-control" @bind="queueConfig.QueueName">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@layoutPresetInputId">Blocks layout</label>
                                    <select id="@layoutPresetInputId" class="form-select" @bind="queueConfig.MessagePageLayout">
                                        <option value="@MessagePageLayoutPreset.TopSendReceiveBottomPayload">Top: Send + Receive, Bottom: Payload</option>
                                        <option value="@MessagePageLayoutPreset.LeftSendReceiveRightPayload">Left: Send + Receive, Right: Payload</option>
                                        <option value="@MessagePageLayoutPreset.LeftSendRightReceiveBottomPayload">Left: Send, Right: Receive + Payload (50/50)</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <h6 class="config-section-label">Message encoding settings</h6>
                                    <div class="form-check d-inline-block me-3">
                                        <input id="@useGzipInputId" class="form-check-input" type="checkbox" @bind="queueConfig.UseGzipCompression"
                                               @bind:after="@(() => OnGzipCompressionChanged(queueConfig))">
                                        <label class="form-check-label" for="@useGzipInputId">Use Gzip Compression</label>
                                    </div>
                                    <div class="form-check d-inline-block">
                                        <input id="@useBase64InputId" class="form-check-input" type="checkbox" @bind="queueConfig.UseBase64Coding"
                                               disabled>
                                        <label class="form-check-label" for="@useBase64InputId">Use Base64 Coding</label>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <h6 class="config-section-label">Message formatting settings</h6>
                                    @{
                                        var formatterIndex = 0;
                                    }
                                    @foreach (var formatter in queueConfig.MessageFormatters)
                                    {
                                        var formatterId = $"sq-formatter-{i}-{formatterIndex++}";
                                        <div class="form-check d-inline-block me-3">
                                            <input id="@formatterId" class="form-check-input" type="checkbox"
                                                   @bind:get="formatter.Value"
                                                   @bind:set="(value) => queueConfig.MessageFormatters[formatter.Key] = value">
                                            <label class="form-check-label" for="@formatterId">@formatter.Key</label>
                                        </div>
                                    }
                                </div>

                                <button class="btn btn-danger" @onclick="() => RemoveStorageQueueConfig(index)">Remove</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @if (activeTab == "servicebus")
    {
        @if (appConfiguration?.ServiceBusConfigs.Count == 0)
        {
            <div class="config-empty-state">
                <i class="bi bi-send-fill config-empty-icon"></i>
                <p class="config-empty-title">No ServiceBus configured</p>
                <p class="config-empty-hint">Click "Add ServiceBus" to create your first connection.</p>
            </div>
        }
        else
        {
            <div class="accordion" id="serviceBusAccordion">
                @for (var i = 0; i < appConfiguration?.ServiceBusConfigs.Count; i++)
                {
                    var index = i;
                    var sbConfig = appConfiguration.ServiceBusConfigs[i];
                    var isExpanded = IsServiceBusExpanded(sbConfig.Id);
                    var collapseId = $"collapse-sb-{sbConfig.Id:N}";
                    var headingId = $"heading-sb-{sbConfig.Id:N}";
                    var titleInputId = $"sb-title-{i}";
                    var connectionStringInputId = $"sb-connection-string-{i}";
                    var entityNameInputId = $"sb-entity-name-{i}";
                    var entityTypeInputId = $"sb-entity-type-{i}";
                    var subscriptionNameInputId = $"sb-subscription-name-{i}";
                    var useGzipInputId = $"sb-use-gzip-{i}";
                    var useBase64InputId = $"sb-use-base64-{i}";
                    var layoutPresetInputId = $"sb-layout-preset-{i}";

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button @(isExpanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId" aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@collapseId"
                                    @onclick="() => ToggleServiceBus(sbConfig.Id)">
                                @sbConfig.Title
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @(isExpanded ? "show" : "")" aria-labelledby="@headingId"
                             data-bs-parent="#serviceBusAccordion">
                            <div class="accordion-body">
                                <div class="mb-3">
                                    <label class="form-label" for="@titleInputId">Title</label>
                                    <input id="@titleInputId" class="form-control" @bind="sbConfig.Title">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@connectionStringInputId">Connection String</label>
                                    <input id="@connectionStringInputId" class="form-control" @bind="sbConfig.ConnectionString">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@entityNameInputId">Entity Name (Queue or Topic)</label>
                                    <input id="@entityNameInputId" class="form-control" @bind="sbConfig.EntityName">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@entityTypeInputId">Entity Type</label>
                                    <select id="@entityTypeInputId" class="form-select" @bind="sbConfig.EntityType">
                                        <option value="@ServiceBusEntityType.Queue">Queue</option>
                                        <option value="@ServiceBusEntityType.Topic">Topic</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@layoutPresetInputId">Blocks layout</label>
                                    <select id="@layoutPresetInputId" class="form-select" @bind="sbConfig.MessagePageLayout">
                                        <option value="@MessagePageLayoutPreset.TopSendReceiveBottomPayload">Top: Send + Receive, Bottom: Payload</option>
                                        <option value="@MessagePageLayoutPreset.LeftSendReceiveRightPayload">Left: Send + Receive, Right: Payload</option>
                                        <option value="@MessagePageLayoutPreset.LeftSendRightReceiveBottomPayload">Left: Send, Right: Receive + Payload (50/50)</option>
                                    </select>
                                </div>

                                @if (sbConfig.EntityType == ServiceBusEntityType.Topic)
                                {
                                    <div class="mb-3">
                                        <label class="form-label" for="@subscriptionNameInputId">Subscription Name (for consuming)</label>
                                        <input id="@subscriptionNameInputId" class="form-control" @bind="sbConfig.SubscriptionName">
                                    </div>
                                }

                                <div class="mb-3">
                                    <h6 class="config-section-label">Message encoding settings</h6>
                                    <div class="form-check d-inline-block me-3">
                                        <input id="@useGzipInputId" class="form-check-input" type="checkbox" @bind="sbConfig.UseGzipCompression"
                                               @bind:after="@(() => OnGzipCompressionChanged(sbConfig))">
                                        <label class="form-check-label" for="@useGzipInputId">Use Gzip Compression</label>
                                    </div>
                                    <div class="form-check d-inline-block">
                                        <input id="@useBase64InputId" class="form-check-input" type="checkbox" @bind="sbConfig.UseBase64Coding"
                                               disabled="@(!sbConfig.UseGzipCompression)">
                                        <label class="form-check-label" for="@useBase64InputId">Use Base64 Coding</label>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <h6 class="config-section-label">Message formatting settings</h6>
                                    @{
                                        var formatterIndex = 0;
                                    }
                                    @foreach (var formatter in sbConfig.MessageFormatters)
                                    {
                                        var formatterId = $"sb-formatter-{i}-{formatterIndex++}";
                                        <div class="form-check d-inline-block me-3">
                                            <input id="@formatterId" class="form-check-input" type="checkbox"
                                                   @bind:get="formatter.Value"
                                                   @bind:set="(value) => sbConfig.MessageFormatters[formatter.Key] = value">
                                            <label class="form-check-label" for="@formatterId">@formatter.Key</label>
                                        </div>
                                    }
                                </div>

                                <button class="btn btn-danger" @onclick="() => RemoveServiceBusConfig(index)">Remove</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @if (activeTab == "rabbitmq")
    {
        @if (appConfiguration?.RabbitMqConfigs.Count == 0)
        {
            <div class="config-empty-state">
                <i class="bi bi-hdd-network-fill config-empty-icon"></i>
                <p class="config-empty-title">No RabbitMQ configured</p>
                <p class="config-empty-hint">Click "Add RabbitMQ" to create your first connection.</p>
            </div>
        }
        else
        {
            <div class="accordion" id="rabbitMqAccordion">
                @for (var i = 0; i < appConfiguration?.RabbitMqConfigs.Count; i++)
                {
                    var index = i;
                    var rbConfig = appConfiguration.RabbitMqConfigs[i];
                    var isExpanded = IsRabbitMqExpanded(rbConfig.Id);
                    var collapseId = $"collapse-rmq-{rbConfig.Id:N}";
                    var headingId = $"heading-rmq-{rbConfig.Id:N}";
                    var titleInputId = $"rmq-title-{i}";
                    var connectionStringInputId = $"rmq-connection-string-{i}";
                    var entityNameInputId = $"rmq-entity-name-{i}";
                    var entityTypeInputId = $"rmq-entity-type-{i}";
                    var exchangeTypeInputId = $"rmq-exchange-type-{i}";
                    var routingKeyInputId = $"rmq-routing-key-{i}";
                    var queueNameInputId = $"rmq-queue-name-{i}";
                    var useGzipInputId = $"rmq-use-gzip-{i}";
                    var useBase64InputId = $"rmq-use-base64-{i}";
                    var layoutPresetInputId = $"rmq-layout-preset-{i}";

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button @(isExpanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId" aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@collapseId"
                                    @onclick="() => ToggleRabbitMq(rbConfig.Id)">
                                @rbConfig.Title
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @(isExpanded ? "show" : "")" aria-labelledby="@headingId"
                             data-bs-parent="#rabbitMqAccordion">
                            <div class="accordion-body">
                                <div class="mb-3">
                                    <label class="form-label" for="@titleInputId">Title</label>
                                    <input id="@titleInputId" class="form-control" @bind="rbConfig.Title">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@connectionStringInputId">Connection String</label>
                                    <input id="@connectionStringInputId" class="form-control" @bind="rbConfig.ConnectionString">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@entityNameInputId">Entity Name (Queue or Exchange)</label>
                                    <input id="@entityNameInputId" class="form-control" @bind="rbConfig.EntityName">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@entityTypeInputId">Entity Type</label>
                                    <select id="@entityTypeInputId" class="form-select" @bind="rbConfig.EntityType">
                                        <option value="@RabbitMqEntityType.Queue">Queue</option>
                                        <option value="@RabbitMqEntityType.Exchange">Exchange</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="@layoutPresetInputId">Blocks layout</label>
                                    <select id="@layoutPresetInputId" class="form-select" @bind="rbConfig.MessagePageLayout">
                                        <option value="@MessagePageLayoutPreset.TopSendReceiveBottomPayload">Top: Send + Receive, Bottom: Payload</option>
                                        <option value="@MessagePageLayoutPreset.LeftSendReceiveRightPayload">Left: Send + Receive, Right: Payload</option>
                                        <option value="@MessagePageLayoutPreset.LeftSendRightReceiveBottomPayload">Left: Send, Right: Receive + Payload (50/50)</option>
                                    </select>
                                </div>

                                @if (rbConfig.EntityType == RabbitMqEntityType.Exchange)
                                {
                                    <div class="mb-3">
                                        <label class="form-label" for="@exchangeTypeInputId">Exchange Type</label>
                                        <select id="@exchangeTypeInputId" class="form-select" @bind="rbConfig.ExchangeType">
                                            <option value="@RabbitMqExchangeType.Direct">Direct</option>
                                            <option value="@RabbitMqExchangeType.Fanout">Fanout</option>
                                            <option value="@RabbitMqExchangeType.Topic">Topic</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="@routingKeyInputId">Routing Key</label>
                                        <input id="@routingKeyInputId" class="form-control" @bind="rbConfig.RoutingKey">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="@queueNameInputId">Queue Name (for consuming)</label>
                                        <input id="@queueNameInputId" class="form-control" @bind="rbConfig.QueueName">
                                    </div>
                                }

                                <div class="mb-3">
                                    <h6 class="config-section-label">Message encoding settings</h6>
                                    <div class="form-check d-inline-block me-3">
                                        <input id="@useGzipInputId" class="form-check-input" type="checkbox" @bind="rbConfig.UseGzipCompression"
                                               @bind:after="@(() => OnGzipCompressionChanged(rbConfig))">
                                        <label class="form-check-label" for="@useGzipInputId">Use Gzip Compression</label>
                                    </div>
                                    <div class="form-check d-inline-block">
                                        <input id="@useBase64InputId" class="form-check-input" type="checkbox" @bind="rbConfig.UseBase64Coding"
                                               disabled="@(!rbConfig.UseGzipCompression)">
                                        <label class="form-check-label" for="@useBase64InputId">Use Base64 Coding</label>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <h6 class="config-section-label">Message formatting settings</h6>
                                    @{
                                        var formatterIndex = 0;
                                    }
                                    @foreach (var formatter in rbConfig.MessageFormatters)
                                    {
                                        var formatterId = $"rmq-formatter-{i}-{formatterIndex++}";
                                        <div class="form-check d-inline-block me-3">
                                            <input id="@formatterId" class="form-check-input" type="checkbox"
                                                   @bind:get="formatter.Value"
                                                   @bind:set="(value) => rbConfig.MessageFormatters[formatter.Key] = value">
                                            <label class="form-check-label" for="@formatterId">@formatter.Key</label>
                                        </div>
                                    }
                                </div>

                                <button class="btn btn-danger" @onclick="() => RemoveRabbitMqConfig(index)">Remove</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>


<ToastNotification @ref="toast" />



@code {
    [Inject] private IEnumerable<IMessageFormatter>? MessageFormatters { get; set; }

    private ToastNotification toast = default!;

    private AppConfiguration? appConfiguration;

    private string activeTab = "eventhubs";

    // Expanded accordion item per tab. Null by default => all collapsed on page open.
    // Single expanded item per tab: expanding one collapses the previous.
    private Guid? expandedEventHubId;
    private Guid? expandedStorageQueueId;
    private Guid? expandedServiceBusId;
    private Guid? expandedRabbitMqId;

    private void SetActiveTab(string tab) => activeTab = tab;

    private bool IsEventHubExpanded(Guid id) => expandedEventHubId == id;
    private bool IsStorageQueueExpanded(Guid id) => expandedStorageQueueId == id;
    private bool IsServiceBusExpanded(Guid id) => expandedServiceBusId == id;
    private bool IsRabbitMqExpanded(Guid id) => expandedRabbitMqId == id;

    private void ToggleEventHub(Guid id) => expandedEventHubId = expandedEventHubId == id ? null : id;
    private void ToggleStorageQueue(Guid id) => expandedStorageQueueId = expandedStorageQueueId == id ? null : id;
    private void ToggleServiceBus(Guid id) => expandedServiceBusId = expandedServiceBusId == id ? null : id;
    private void ToggleRabbitMq(Guid id) => expandedRabbitMqId = expandedRabbitMqId == id ? null : id;

    protected override async Task OnInitializedAsync()
    {
        await LoadConfiguration();
    }

    private async Task LoadConfiguration()
    {
        appConfiguration = await ConfigurationProvider.GetDataAsync() ?? new AppConfiguration();

        foreach (var eventHubConfig in appConfiguration.EventHubsConfigs)
        {
            if (eventHubConfig.MessageFormatters.Count == MessageFormatters?.Count())
                continue;

            foreach (var msgFormatter in MessageFormatters ?? Enumerable.Empty<IMessageFormatter>())
            {
                eventHubConfig.MessageFormatters.TryAdd(msgFormatter.Name, false);
            }
        }

        foreach (var queueConfig in appConfiguration.StorageQueuesConfigs)
        {
            if (queueConfig.MessageFormatters.Count == MessageFormatters?.Count())
                continue;

            foreach (var msgFormatter in MessageFormatters ?? Enumerable.Empty<IMessageFormatter>())
            {
                queueConfig.MessageFormatters.TryAdd(msgFormatter.Name, false);
            }
        }

        foreach (var sbConfig in appConfiguration.ServiceBusConfigs)
        {
            if (sbConfig.MessageFormatters.Count == MessageFormatters?.Count())
                continue;

            foreach (var msgFormatter in MessageFormatters ?? Enumerable.Empty<IMessageFormatter>())
            {
                sbConfig.MessageFormatters.TryAdd(msgFormatter.Name, false);
            }
        }

        foreach (var rbConfig in appConfiguration.RabbitMqConfigs)
        {
            if (rbConfig.MessageFormatters.Count == MessageFormatters?.Count())
                continue;

            foreach (var msgFormatter in MessageFormatters ?? Enumerable.Empty<IMessageFormatter>())
            {
                rbConfig.MessageFormatters.TryAdd(msgFormatter.Name, false);
            }
        }
    }

    private async Task SaveConfiguration()
    {
        if (appConfiguration is null) return;
        await ConfigurationProvider.SaveDataAsync(appConfiguration);

        await toast.ShowToast("Configuration saved", ToastType.Info);
    }

    
    private void AddNewEventHubConfig()
    {
        var newConfig = new EventHubConfig
        {
            Title = "New Event Hub",
            ConnectionString = "",
            Name = "",
            MessagePageLayout = MessagePageLayoutPreset.TopSendReceiveBottomPayload,
            MessageFormatters = MessageFormatters?.ToDictionary(k => k.Name, v => false) ?? new Dictionary<string, bool>(),
            UseCheckpoints = false,
            StorageConfig = new BlobConfig { ConnectionString = "", BlobContainerName = "" }
        };
        appConfiguration?.EventHubsConfigs.Add(newConfig);
        // New configs are expanded by default.
        expandedEventHubId = newConfig.Id;
    }

